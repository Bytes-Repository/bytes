extern dynamic [c] is
    fn system(cmd: string) -> int
    fn exit(code: int)
end

fn find_hsh() -> string is
    let bins: [string] = ["h#", "/usr/bin/h#", "hsharp"]
    for b in bins is
        if system("command -v " + b + " >/dev/null 2>&1") == 0 is return b end
    end
    return "h#"
end

;; ── Argument helpers ──────────────────────────────────────────────────────────

fn arg_at(args: [string], argc: int, i: int) -> string is
    if i < argc is return args[i] end
    return ""
end

fn arg_has(args: [string], argc: int, flag: string) -> bool is
    let mut i: int = 0
    while i < argc is
        if args[i] == flag is return true end
        i += 1
    end
    return false
end

fn args_from(args: [string], argc: int, start_idx: int) -> [string] is
    let mut result: [string] = []
    let mut i: int = start_idx
    while i < argc is
        result = array_push(result, args[i])
        i += 1
    end
    return result
end

fn args_positional(args: [string], argc: int) -> [string] is
    let mut result: [string] = []
    let mut i: int = 0
    while i < argc is
        if !string_starts_with(args[i], "-") is
            result = array_push(result, args[i])
        end
        i += 1
    end
    return result
end

