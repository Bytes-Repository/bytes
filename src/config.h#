pub struct PackageConfig is
    pub name:        string
    pub version:     string
    pub description: string
    pub entry:       string
    pub author:      string
    pub license:     string
end

pub struct BuildConfig is
    pub lang:        string
    pub entry:       string
    pub output:      string
    pub emit:        string
    pub flags:       string
    pub parallel:    bool
    pub cache_dir:   string
    pub build_order: string
    ;; Extra `mod X` search directory, passed through to `h# compile` as
    ;; `-I <include>` (repeatable in the H# CLI, but bytes.hk only exposes
    ;; a single directory per project for now — the common case, and the
    ;; one Isolator's `isolated`/`Bytes.hk` uses to reuse
    ;; `../source-code/src` directly instead of duplicating files). Empty
    ;; string means "no extra include dir" (the default, and what every
    ;; existing project's Bytes.hk without this key gets).
    pub include:     string
    ;; Project-wide default `MemoryMode` ("default"/"safety"/"arc"/
    ;; "arena"/"pointers", or "" for none) — passed to `hsharp compile`/
    ;; `build` as `--mem-mode <value>` (see build.h#'s build_single) so
    ;; every file in the project falls back to it unless it has its own
    ;; `@: mode` first line, or a given function has its own `@mode`
    ;; annotation (both of those still win over this). Lets a whole
    ;; project opt into e.g. `@safety` from one place in bytes.hk instead
    ;; of a `@: safety` line copy-pasted into every single source file.
    pub mem_mode:    string
end

pub struct DepEntry is
    pub name:   string
    pub kind:   string
    pub source: string
end

pub struct WorkspaceConfig is
    pub name:        string
    pub version:     string
    pub mode:        string
    pub members:     string
    pub languages:   string
    pub build_order: string
end

pub struct Project is
    pub package:       PackageConfig
    pub build:         BuildConfig
    pub workspace:     WorkspaceConfig
    pub deps:          [DepEntry]
    pub dep_count:     int
    pub has_workspace: bool
    pub root_path:     string
    ;; Hard [deps] validation failures collected during `parse` (e.g. a
    ;; bare `-> name => git` with no actual repo). Kept on the struct
    ;; instead of failing inside `parse` itself so `parse` stays a pure
    ;; function; `load`/`load_path` are what turn these into the
    ;; `error:` + exit(1) every other missing/broken-project case already
    ;; uses.
    pub errors:        [string]
end

pub fn default_project() -> Project is
    return Project {
        package: PackageConfig {
            name: "unnamed", version: "0.1.0", description: "",
            entry: "src/main.h#", author: "", license: "MIT"
        },
        build: BuildConfig {
            lang: "h#", entry: "src/main.h#", output: "build/main",
            emit: "bin", flags: "", parallel: false,
            cache_dir: "build/cache", build_order: "", mem_mode: "",
            include: ""
        },
        workspace: WorkspaceConfig {
            name: "", version: "", mode: "standard",
            members: "", languages: "", build_order: ""
        },
        deps: [], dep_count: 0,
        has_workspace: false, root_path: ".",
        errors: [],
    }
end

;; ── Dependency accessors ─────────────────────────────────────────────────────
;;
;; [FIX] installer.h#, deps.h#, cli.h# and info.h# all call these as
;; `config::dep_count(proj)` / `config::dep_at(proj, i)` /
;; `config::dep_name(dep)` / `config::dep_kind(dep)` / `config::dep_source(dep)`,
;; but none of them were ever defined — `dep_count` only existed as the
;; `Project.dep_count` *field*, and `DepEntry.name/kind/source` only as
;; plain fields, never as callable functions. The h# v0.8 LLVM backend has
;; no fallback for that: a call to a name with no matching function is a
;; hard `codegen: undefined fn` error, which is exactly what surfaced when
;; compiling `src/main.h#` (first hit at installer.h#'s `dep_count` call,
;; but every other call below was equally broken and would have failed
;; next, one at a time, as each got fixed in turn).
;;
;; These follow the same same-module-accessor pattern already used for
;; `ws_name`/`ws_version`/`ws_mode`/`ws_build_order`/`build_cache_dir`
;; above: `DepEntry` (like `WorkspaceConfig`) shares field names ("name",
;; "kind"/"source") with other structs in this project (`PackageConfig`,
;; `DocItem`, ...), so a raw cross-module `dep.name` chain risks the same
;; "cannot statically determine the struct type — guessing" ambiguity the
;; compiler warns about for those. Defining the accessor here, in the
;; same module as the struct itself, sidesteps that entirely.
pub fn dep_count(proj: Project) -> int is
    return proj.dep_count
end

pub fn dep_at(proj: Project, i: int) -> DepEntry is
    return proj.deps[i]
end

pub fn dep_name(dep: DepEntry) -> string is
    return dep.name
end

pub fn dep_kind(dep: DepEntry) -> string is
    return dep.kind
end

pub fn dep_source(dep: DepEntry) -> string is
    return dep.source
end

;; ── Parser .hk ───────────────────────────────────────────────────────────────

fn hk_trim(s: string) -> string is return string_trim(s) end

pub fn hk_parse_value(line: string) -> string is
    let idx: int = string_find(line, "=>")
    if idx < 0 is return "" end
    let v: string = hk_trim(string_slice(line, idx + 2, string_len(line)))
    let v: string = string_replace(v, "\"", "")
    ;; Strip inline comment: "  !" or "  ;;"
    let bang:  int = string_find(v, "  !")
    let semi:  int = string_find(v, "  ;;")
    let cut:   int = if bang >= 0 && (semi < 0 || bang < semi) then bang
                     else if semi >= 0 then semi else -1  
    return if cut >= 0 then hk_trim(string_slice(v, 0, cut)) else v 
end

;; ── [deps] value classification ─────────────────────────────────────────────
;;
;; A `-> name => <value>` line's `<value>` can be:
;;   - "dynamic" / "static"      → link against a system library
;;   - a real git URL            → clone that repo (kind "git")
;;   - "vX[.Y[.Z]]" (e.g. "v0.2") → pin to that exact published version
;;     (kind "version"; resolved from the Bytes registry + a matching git
;;     tag — see installer.h#'s `install_bytes_dep_pinned`)
;;   - "newest" (case-insensitive) → always take the latest revision and
;;     build it from source instead of trusting whatever is cached
;;     (kind "newest" — see `install_bytes_dep_newest`)
;;   - "path:<dir>", or a bare `./dir` / `../dir` / `/abs/dir` with no
;;     prefix at all → a sibling package that already lives on disk
;;     (kind "path" — see installer.h#'s `install_path_dep`, which
;;     symlinks `<dir>` straight into `build/cache/packages/<name>` so
;;     the H# compiler's own package resolution, `bytes_resolve.rs`'s
;;     `find_pkg_entry`, finds it exactly like any fetched dependency)
;;   - anything else / empty     → plain bytes-registry lookup by name
;;     (kind "bytes", unchanged default behaviour)
;;
;; [FIXED] `install_path_dep` (installer.h#) and the "path" row in
;; `deps.h#`'s `show_deps` table were both already written and wired up
;; — `install_hsharp_deps`'s dispatch already has a `"path" =>
;; install_path_dep(...)` arm — but nothing here ever actually produced
;; `kind: "path"`: every value that wasn't "dynamic"/"static"/a version
;; spec/"newest"/a git or http URL fell straight through to the final
;; `else "bytes"` below, i.e. a registry lookup. That's exactly what
;; happened to `hsh`'s `-> hprompt => newest` dependency on its sibling
;; `../hprompt` package: classified "newest", looked up in the (empty,
;; for an unpublished local package) registry, found nothing, and
;; `install_bytes_dep_newest` fell back to writing an empty stub file —
;; which the H# compiler's `resolve_bytes_import` then dutifully
;; imported (no import-time error — the stub package genuinely exists
;; on disk), only to fail later at codegen with "undefined fn" for
;; every real function the stub doesn't define. Recognizing "path:..."
;; / a bare relative-or-absolute directory here, ahead of the final
;; "bytes" fallback, is what actually routes such a dependency to
;; `install_path_dep` instead.
;;
;; The bare word "git" with nothing else (`-> lib => git`) used to also
;; fall into the "git" bucket via `starts_with(val, "git")` below, and
;; `install_git_dep` would then try `git clone --depth=1 'git' ...` —
;; silently doomed to fail, since "git" names no repository at all. That
;; is never what's meant: a real git dependency needs an actual URL
;; (`https://...`, `git://...`, or `git@host:owner/repo.git`, all of
;; which still match `starts_with(val, "git")` further down and are
;; unaffected). So the exact literal "git" is now rejected up front as a
;; hard [deps] error rather than an install-time warning.
fn is_bare_git_literal(val: string) -> bool is
    return string_lower(hk_trim(val)) == "git"
end

fn is_newest_spec(val: string) -> bool is
    return string_lower(hk_trim(val)) == "newest"
end

;; "v" followed by at least one digit, e.g. "v0", "v0.2", "v1.4.10".
fn is_version_spec(val: string) -> bool is
    let v: string = hk_trim(val)
    if string_len(v) < 2 || string_at(v, 0) != "v" is return false end
    let c: string = string_at(v, 1)
    return c >= "0" && c <= "9"
end

;; "path:<dir>" (explicit prefix), or a bare directory reference with no
;; prefix at all — `./dir`, `../dir`, or an absolute `/dir`. A plain
;; bare word with none of those leading forms (e.g. a package name
;; that's meant for the registry) is deliberately NOT treated as a
;; path — only these unambiguous directory-shaped forms are, so an
;; ordinary `-> somepkg => bytes`-style registry dep can never be
;; accidentally reclassified.
fn is_path_spec(val: string) -> bool is
    let v: string = hk_trim(val)
    ;; [FIXED] Was written as `return A || B || C || D` split across
    ;; lines with each `||` LEADING the next line. That's the opposite
    ;; of the only multi-line-boolean style already used elsewhere in
    ;; this codebase (config.h#'s own `if line == "" || ... ||` a few
    ;; hundred lines up, doc_gen.h#, fmt_cmd.h#) — those all put the
    ;; operator TRAILING at the end of the line, so the parser is still
    ;; visibly mid-expression when the newline hits. With a leading
    ;; `||`, `return string_starts_with(v, "path:")` reads as a
    ;; complete, valid statement all by itself, so the parser closes it
    ;; right there — and then sees the next line starting with `||` as
    ;; the start of a *new* expression, which it parses as a Rust-style
    ;; zero-argument closure literal (`|| body`), not as "OR with the
    ;; previous line". The LLVM backend has no closure support at all,
    ;; hence "closures are not implemented" — a genuinely confusing
    ;; error for what was really just an operator-placement mistake on
    ;; my part. Side-stepped entirely here with separate single-line
    ;; `if/is/end` checks instead of relying on any multi-line operator
    ;; continuation.
    if string_starts_with(v, "path:") is return true end
    if string_starts_with(v, "./") is return true end
    if string_starts_with(v, "../") is return true end
    if string_starts_with(v, "/") is return true end
    return false
end

;; Strips a leading "path:" if present; a bare `./`/`../`/`/` form is
;; already exactly the directory `install_path_dep` wants and passes
;; through unchanged.
fn path_spec_dir(val: string) -> string is
    let v: string = hk_trim(val)
    return if string_starts_with(v, "path:") then string_slice(v, 5, string_len(v)) else v 
end

pub fn hk_parse_key(line: string) -> string is
    let t: string = hk_trim(line)
    let mut i: int = 0
    while i < string_len(t) && string_at(t, i) == "-" is i += 1 end
    if i < string_len(t) && string_at(t, i) == ">" is i += 1 end
    let t: string = hk_trim(string_slice(t, i, string_len(t)))
    let arrow: int = string_find(t, "=>")
    if arrow < 0 is return hk_trim(t) end
    return hk_trim(string_slice(t, 0, arrow))
end

pub fn parse(content: string) -> Project is
    let mut proj: Project   = default_project()
    let mut section:    string = ""
    let mut sub:        string = ""

    let lines:  [string] = string_split(content, "\n")
    let nlines: int = array_len(lines)
    let mut i: int = 0

    while i < nlines is
        let line: string = hk_trim(lines[i])
        i += 1

        if line == "" || string_starts_with(line, "!") ||
           string_starts_with(line, ";;") || string_starts_with(line, "#") is
            continue
        end

        if string_starts_with(line, "[") && string_ends_with(line, "]") is
            section = string_slice(line, 1, string_len(line) - 1)
            sub = ""
            continue
        end

        if !string_starts_with(line, "->") is continue end

        let key: string = hk_parse_key(line)
        let val: string = hk_parse_value(line)

        ;; Key with no value = subsection marker
        if val == "" && !string_contains(line, "=>") is
            sub = key
            continue
        end

        match section is
            "package" => is
                match key is
                    "name"        => is proj.package.name        = val end
                    "version"     => is proj.package.version     = val end
                    "description" => is proj.package.description = val end
                    "entry"       => is proj.package.entry       = val end
                    "author"      => is proj.package.author      = val end
                    "license"     => is proj.package.license     = val end
                    _ => is end
                end
            end
            "build" => is
                match key is
                    "lang"        => is proj.build.lang        = val end
                    "entry"       => is proj.build.entry       = val end
                    "output"      => is proj.build.output      = val end
                    "emit"        => is proj.build.emit        = val end
                    "flags"       => is proj.build.flags       = val end
                    "parallel"    => is proj.build.parallel    = val == "true" end
                    "cache"       => is proj.build.cache_dir   = val end
                    "build-order" => is proj.build.build_order = val end
                    "mem-mode"    => is proj.build.mem_mode    = val end
                    "include"     => is proj.build.include     = val end
                    _ => is end
                end
            end
            "workspace" => is
                proj.has_workspace = true
                if sub == "languages" is
                    let member: string = hk_trim(string_replace(key, "-", ""))
                    proj.workspace.languages = proj.workspace.languages + member + "=" + val + ","
                else is
                    match key is
                        "name"        => is proj.workspace.name        = val end
                        "version"     => is proj.workspace.version     = val end
                        "mode"        => is proj.workspace.mode        = val end
                        "members"     => is proj.workspace.members     = val end
                        "build-order" => is proj.workspace.build_order = val end
                        _ => is end
                    end
                end
            end
            "deps" => is
                if is_bare_git_literal(val) is
                    proj.errors = array_push(proj.errors,
                        "[deps] '" + key + " => git' is not a valid source — " +
                        "'git' alone doesn't name a repository. Use a full URL " +
                        "(e.g. 'https://github.com/owner/" + key + ".git') or " +
                        "'git@host:owner/" + key + ".git' instead.")
                    proj.deps      = array_push(proj.deps, DepEntry { name: key, kind: "invalid", source: val })
                    proj.dep_count += 1
                else is
                    let kind: string = if val == "dynamic" || val == "static" then val
                                       else if is_newest_spec(val) then "newest"
                                       else if is_version_spec(val) then "version"
                                       else if string_starts_with(val, "git") then "git"
                                       else if string_starts_with(val, "http") then "git"
                                       else if is_path_spec(val) then "path"
                                       else "bytes"
                    let source: string = if kind == "path" then path_spec_dir(val) else val 
                    proj.deps      = array_push(proj.deps, DepEntry { name: key, kind: kind, source: source })
                    proj.dep_count += 1
                end
            end
            _ => is end
        end
    end

    if proj.package.name == "" is proj.package.name = "unnamed" end
    return proj
end

;; ── File finders ─────────────────────────────────────────────────────────────

pub fn find_hk() -> string is
    ;; `Bytes.hk` is the canonical name (checked first) — `bytes.hk` and
    ;; the old `.toml` names are still recognized for backward
    ;; compatibility with existing projects, but every new project (see
    ;; new.h#) and every place bytes.hk itself *writes* a config file now
    ;; canonically uses `Bytes.hk`.
    let candidates: [string] = ["Bytes.hk", "bytes.hk", "Bytes.toml", "bytes.toml"]
    for c in candidates is
        if file_exists(c) is return c end
    end
    return ""
end

pub fn find_hk_upward() -> string is
    ;; Search current dir and up to 5 parents
    let direct: string = find_hk()
    if direct != "" is return direct end
    let mut dir: string = ".."
    let mut depth: int = 0
    while depth < 5 is
        for name in ["Bytes.hk", "bytes.hk"] is
            let p: string = dir + "/" + name
            if file_exists(p) is return p end
        end
        dir   = dir + "/.."
        depth += 1
    end
    return ""
end

;; Prints every collected [deps] validation error and exits(1) if there
;; are any — shared by `load` and `load_path` so both entry points give
;; the same hard failure instead of silently limping on with a broken
;; dependency (see `is_bare_git_literal` above for why "git" alone is
;; now one of these).
fn fail_on_errors(proj: Project) is
    if array_len(proj.errors) == 0 is return end
    let mut i: int = 0
    while i < array_len(proj.errors) is
        write("  \x1b[31merror:\x1b[0m " + proj.errors[i])
        i += 1
    end
    exit(1)
end

pub fn load() -> Project is
    let path: string = find_hk()
    if path == "" is
        write("  \x1b[31merror:\x1b[0m Bytes.hk not found")
        write("  Run 'bytes new <name>' to create a project")
        exit(1)
    end
    let mut proj: Project = parse(file_read(path))
    proj.root_path = "."
    fail_on_errors(proj)
    return proj
end

pub fn load_path(path: string) -> Project is
    let mut proj: Project = parse(file_read(path))
    let slash: int = string_rfind(path, "/")
    proj.root_path = if slash >= 0 then string_slice(path, 0, slash) else "." 
    fail_on_errors(proj)
    return proj
end

;; ── Accessors ────────────────────────────────────────────────────────────────

pub fn pkg_name(proj: Project) -> string is return proj.package.name end
pub fn pkg_version(proj: Project) -> string is return proj.package.version end

pub fn build_entry(proj: Project) -> string is
    if proj.build.entry != "" is return proj.build.entry end
    if proj.package.entry != "" is return proj.package.entry end
    return "src/main.h#"
end

pub fn build_output(proj: Project) -> string is
    if proj.build.output != "" is return proj.build.output end
    return "build/" + proj.package.name
end

pub fn build_lang(proj: Project) -> string is
    if proj.build.lang != "" is return proj.build.lang end
    return "h#"
end

;; [FIXED] `workspace.h#` used to read `ws.name`, `ws.version` and
;; `ws.build_order` directly off a `let ws: WorkspaceConfig = proj.workspace`
;; local — a cross-module nested-field chain. The h# v0.8 compiler warns
;; "cannot statically determine the struct type of `.name`/`.version`/
;; `.build_order` — guessing by scanning all structs for a matching field
;; name" for exactly this pattern, because `PackageConfig`, `WorkspaceConfig`
;; and `BuildConfig` all have fields with the same names (`name`, `version`,
;; `build_order`). At runtime the guess picks the wrong struct's field
;; layout, so `ws.version` was silently reading back `ws.mode`'s value
;; instead (reproduced live: `bytes build` printed "hco-workspace
;; vstandard" instead of "hco-workspace v0.4.0" — "standard" is the
;; *mode*, not the version). Every other nested-field read in this file
;; (`build_entry`, `build_output`, `ws_members`, `pkg_name`, ...) already
;; goes through a same-module accessor function instead of a raw chain,
;; and those never triggered the warning — so the fix is to give
;; `WorkspaceConfig`'s fields the same treatment instead of reading them
;; directly from other modules.
pub fn ws_name(proj: Project) -> string is
    return proj.workspace.name
end

pub fn ws_version(proj: Project) -> string is
    return proj.workspace.version
end

pub fn ws_mode(proj: Project) -> string is
    return proj.workspace.mode
end

pub fn ws_build_order(proj: Project) -> string is
    return proj.workspace.build_order
end

;; [FIXED] `jit.h#`'s `jit_cache_new` used to read `proj.build.cache_dir`
;; directly — the same cross-module ambiguous-chain issue as
;; `ws_name`/`ws_version` above (`.build` and `.cache_dir` both flagged
;; by the compiler: "cannot statically determine the struct type of
;; `.build`/`.cache_dir` — guessing by scanning all structs"). Added
;; here for the same reason: a same-module accessor resolves correctly.
pub fn build_cache_dir(proj: Project) -> string is
    if proj.build.cache_dir != "" is return proj.build.cache_dir end
    return "build/cache"
end

pub fn ws_members(proj: Project) -> [string] is
    let raw: string = string_replace(string_replace(
        string_replace(proj.workspace.members, "[", ""), "]", ""), "\"", "")
    let parts: [string] = string_split(raw, ",")
    let n: int = array_len(parts)
    let mut result: [string] = []
    let mut i: int = 0
    while i < n is
        let m: string = string_trim(parts[i])
        if m != "" is result = array_push(result, m) end
        i += 1
    end
    return result
end

pub fn ws_member_lang(proj: Project, member: string) -> string is
    let pairs: [string] = string_split(proj.workspace.languages, ",")
    let n: int = array_len(pairs)
    let mut i: int = 0
    while i < n is
        let pair: string = string_trim(pairs[i])
        let eq: int = string_find(pair, "=")
        if eq > 0 is
            let m: string = string_trim(string_slice(pair, 0, eq))
            let l: string = string_trim(string_slice(pair, eq + 1, string_len(pair)))
            if m == member is return l end
        end
        i += 1
    end
    return "h#"
end

;; ── Templates ────────────────────────────────────────────────────────────────

pub fn tpl_package(name: string) -> string is
    return "[package]\n-> name        => " + name + "\n" +
           "-> version     => 0.1.0\n-> description => " + name + "\n" +
           "-> author      =>\n-> license     => MIT\n\n" +
           "[build]\n-> lang   => h#\n-> entry  => src/main.h#\n" +
           "-> output => build/" + name + "\n\n[deps]\n"
end

pub fn tpl_workspace(name: string) -> string is
    return "! " + name + " workspace\n\n[workspace]\n" +
           "-> name    => " + name + "\n-> version => 0.1.0\n" +
           "-> mode    => standard\n-> members => [\"" + name + "-core\"]\n\n" +
           "[build]\n-> parallel => true\n-> cache    => build/cache/\n"
end

pub fn tpl_lib_hk(name: string) -> string is
    return "[package]\n-> name    => " + name + "\n-> version => 0.1.0\n\n" +
           "[build]\n-> lang   => h#\n-> entry  => src/lib.h#\n" +
           "-> output => build/lib" + name + "\n-> emit   => lib\n"
end

pub fn tpl_main(name: string) -> string is
    return ";; " + name + " — main entry point\n\nfn main() is\n" +
           "    write(\"Hello from " + name + "!\")\nend\n"
end

pub fn tpl_lib_source(name: string) -> string is
    return ";; " + name + " — library\n\npub fn hello() -> string is\n" +
           "    return \"Hello from " + name + "!\"\nend\n"
end

pub fn tpl_gitignore() -> string is
    return "build/\nbuild/cache/\n*.jit\n*.h#bc\n"
end

pub fn tpl_hk_gitignore() -> string is
    return "build/\nbuild/cache/\n*.jit\n*.h#bc\n"
end
