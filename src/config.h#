pub fn tpl_package(name: string) -> string is
    return "[package]\n-> name        => " + name + "\n" +
           "-> version     => 0.1.0\n-> description => " + name + "\n" +
           "-> author      =>\n-> license     => MIT\n\n" +
           "[build]\n-> lang   => h#\n-> entry  => src/main.h#\n" +
           "-> output => build/" + name + "\n\n[deps]\n\n" +
           "[features]\n! -> default => [\"\"]\n! -> extra   => [\"dep:some_optional_dep\"]\n"
end

pub fn tpl_workspace(name: string) -> string is
    return "! " + name + " workspace\n\n[workspace]\n" +
           "-> name    => " + name + "\n-> version => 0.1.0\n" +
           "-> mode    => standard\n-> members => [\"" + name + "-core\"]\n\n" +
           "[build]\n-> parallel => true\n-> cache    => build/cache/\n"
end

pub fn tpl_lib_hk(name: string) -> string is
    return "[package]\n-> name    => " + name + "\n-> version => 0.1.0\n\n" +
           "[build]\n-> lang   => h#\n-> entry  => src/lib.h#\n" +
           "-> output => build/lib" + name + "\n-> emit   => lib\n"
end

pub fn tpl_main(name: string) -> string is
    return ";; " + name + " — main entry point\n\nfn main() is\n" +
           "    write(\"Hello from " + name + "!\")\nend\n"
end

pub fn tpl_lib_source(name: string) -> string is
    return ";; " + name + " — library\n\npub fn hello() -> string is\n" +
           "    return \"Hello from " + name + "!\"\nend\n"
end

pub fn tpl_gitignore() -> string is
    return "build/\nbuild/cache/\n*.jit\n*.h#bc\n"
end

pub fn tpl_hk_gitignore() -> string is
    return "build/\nbuild/cache/\n*.jit\n*.h#bc\n"
end

;; [FEATURES] Generates a tiny H# module exposing the resolved feature
;; set to the project's own code at runtime — the closest equivalent
;; this toolchain has to Cargo's `cfg(feature = "x")`, since H# compile
;; itself has no documented conditional-compilation/`--cfg` mechanism to
;; hook into (unlike rustc). Written to `build/cache/bytes_features.h#`
;; by `build::build_single`/`installer::install_all` on every build; a
;; project opts in by adding `mod bytes_features` to its entry file and
;; `-> include => build/cache` under `[build]` in Bytes.hk, then calling
;; `bytes_features::has("json")` / `bytes_features::list()`.
pub fn gen_feature_module(enabled: [string]) -> string is
    let mut lines: string = ";; Auto-generated by `bytes` from the resolved --features set.\n" +
        ";; Do not edit by hand — regenerated on every build/install.\n\n" +
        "pub fn has(name: string) -> bool is\n    match name is\n"
    let mut i: int = 0
    while i < array_len(enabled) is
        if !string_starts_with(enabled[i], "dep:") is
            lines = lines + "        \"" + enabled[i] + "\" => is return true end\n"
        end
        i += 1
    end
    lines = lines + "        _ => is return false end\n    end\nend\n\n" +
        "pub fn list() -> [string] is\n    return [" +
        string_feature_list_literal(enabled) + "]\nend\n"
    return lines
end

fn string_feature_list_literal(enabled: [string]) -> string is
    let mut out: string = ""
    let mut i: int = 0
    while i < array_len(enabled) is
        if !string_starts_with(enabled[i], "dep:") is
            if out != "" is out = out + ", " end
            out = out + "\"" + enabled[i] + "\""
        end
        i += 1
    end
    return out
end
