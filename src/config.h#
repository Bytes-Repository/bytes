pub struct PackageConfig is
    pub name:        string
    pub version:     string
    pub description: string
    pub entry:       string
    pub author:      string
    pub license:     string
end

pub struct BuildConfig is
    pub lang:        string
    pub entry:       string
    pub output:      string
    pub emit:        string
    pub flags:       string
    pub parallel:    bool
    pub cache_dir:   string
    pub build_order: string
    ;; Extra `mod X` search directory, passed through to `h# compile` as
    ;; `-I <include>` (repeatable in the H# CLI, but bytes.hk only exposes
    ;; a single directory per project for now — the common case, and the
    ;; one Isolator's `isolated`/`Bytes.hk` uses to reuse
    ;; `../source-code/src` directly instead of duplicating files). Empty
    ;; string means "no extra include dir" (the default, and what every
    ;; existing project's Bytes.hk without this key gets).
    pub include:     string
    ;; Project-wide default `MemoryMode` ("default"/"safety"/"arc"/
    ;; "arena"/"pointers", or "" for none) — passed to `hsharp compile`/
    ;; `build` as `--mem-mode <value>` (see build.h#'s build_single) so
    ;; every file in the project falls back to it unless it has its own
    ;; `@: mode` first line, or a given function has its own `@mode`
    ;; annotation (both of those still win over this). Lets a whole
    ;; project opt into e.g. `@safety` from one place in bytes.hk instead
    ;; of a `@: safety` line copy-pasted into every single source file.
    pub mem_mode:    string
end

pub struct DepEntry is
    pub name:   string
    pub kind:   string
    pub source: string
end

pub struct WorkspaceConfig is
    pub name:        string
    pub version:     string
    pub mode:        string
    pub members:     string
    pub languages:   string
    pub build_order: string
end

pub struct Project is
    pub package:       PackageConfig
    pub build:         BuildConfig
    pub workspace:     WorkspaceConfig
    pub deps:          [DepEntry]
    pub dep_count:     int
    pub has_workspace: bool
    pub root_path:     string
end

pub fn default_project() -> Project is
    return Project {
        package: PackageConfig {
            name: "unnamed", version: "0.1.0", description: "",
            entry: "src/main.h#", author: "", license: "MIT"
        },
        build: BuildConfig {
            lang: "h#", entry: "src/main.h#", output: "build/main",
            emit: "bin", flags: "", parallel: false,
            cache_dir: "build/cache", build_order: "", mem_mode: "",
            include: ""
        },
        workspace: WorkspaceConfig {
            name: "", version: "", mode: "standard",
            members: "", languages: "", build_order: ""
        },
        deps: [], dep_count: 0,
        has_workspace: false, root_path: ".",
    }
end

;; ── Parser .hk ───────────────────────────────────────────────────────────────

fn hk_trim(s: string) -> string is return string_trim(s) end

pub fn hk_parse_value(line: string) -> string is
    let idx: int = string_find(line, "=>")
    if idx < 0 is return "" end
    let v: string = hk_trim(string_slice(line, idx + 2, string_len(line)))
    let v: string = string_replace(v, "\"", "")
    ;; Strip inline comment: "  !" or "  ;;"
    let bang:  int = string_find(v, "  !")
    let semi:  int = string_find(v, "  ;;")
    let cut:   int = if bang >= 0 && (semi < 0 || bang < semi) then bang
                     else if semi >= 0 then semi else -1  
    return if cut >= 0 then hk_trim(string_slice(v, 0, cut)) else v 
end

pub fn hk_parse_key(line: string) -> string is
    let t: string = hk_trim(line)
    let mut i: int = 0
    while i < string_len(t) && string_at(t, i) == "-" is i += 1 end
    if i < string_len(t) && string_at(t, i) == ">" is i += 1 end
    let t: string = hk_trim(string_slice(t, i, string_len(t)))
    let arrow: int = string_find(t, "=>")
    if arrow < 0 is return hk_trim(t) end
    return hk_trim(string_slice(t, 0, arrow))
end

pub fn parse(content: string) -> Project is
    let mut proj: Project   = default_project()
    let mut section:    string = ""
    let mut sub:        string = ""

    let lines:  [string] = string_split(content, "\n")
    let nlines: int = array_len(lines)
    let mut i: int = 0

    while i < nlines is
        let line: string = hk_trim(lines[i])
        i += 1

        if line == "" || string_starts_with(line, "!") ||
           string_starts_with(line, ";;") || string_starts_with(line, "#") is
            continue
        end

        if string_starts_with(line, "[") && string_ends_with(line, "]") is
            section = string_slice(line, 1, string_len(line) - 1)
            sub = ""
            continue
        end

        if !string_starts_with(line, "->") is continue end

        let key: string = hk_parse_key(line)
        let val: string = hk_parse_value(line)

        ;; Key with no value = subsection marker
        if val == "" && !string_contains(line, "=>") is
            sub = key
            continue
        end

        match section is
            "package" => is
                match key is
                    "name"        => is proj.package.name        = val end
                    "version"     => is proj.package.version     = val end
                    "description" => is proj.package.description = val end
                    "entry"       => is proj.package.entry       = val end
                    "author"      => is proj.package.author      = val end
                    "license"     => is proj.package.license     = val end
                    _ => is end
                end
            end
            "build" => is
                match key is
                    "lang"        => is proj.build.lang        = val end
                    "entry"       => is proj.build.entry       = val end
                    "output"      => is proj.build.output      = val end
                    "emit"        => is proj.build.emit        = val end
                    "flags"       => is proj.build.flags       = val end
                    "parallel"    => is proj.build.parallel    = val == "true" end
                    "cache"       => is proj.build.cache_dir   = val end
                    "build-order" => is proj.build.build_order = val end
                    "mem-mode"    => is proj.build.mem_mode    = val end
                    "include"     => is proj.build.include     = val end
                    _ => is end
                end
            end
            "workspace" => is
                proj.has_workspace = true
                if sub == "languages" is
                    let member: string = hk_trim(string_replace(key, "-", ""))
                    proj.workspace.languages = proj.workspace.languages + member + "=" + val + ","
                else is
                    match key is
                        "name"        => is proj.workspace.name        = val end
                        "version"     => is proj.workspace.version     = val end
                        "mode"        => is proj.workspace.mode        = val end
                        "members"     => is proj.workspace.members     = val end
                        "build-order" => is proj.workspace.build_order = val end
                        _ => is end
                    end
                end
            end
            "deps" => is
                let kind: string = if val == "dynamic" || val == "static" then val
                                   else if string_starts_with(val, "git") then "git"
                                   else if string_starts_with(val, "http") then "git"
                                   else "bytes"
                proj.deps      = array_push(proj.deps, DepEntry { name: key, kind: kind, source: val })
                proj.dep_count += 1
            end
            _ => is end
        end
    end

    if proj.package.name == "" is proj.package.name = "unnamed" end
    return proj
end

;; ── File finders ─────────────────────────────────────────────────────────────

pub fn find_hk() -> string is
    ;; `Bytes.hk` is the canonical name (checked first) — `bytes.hk` and
    ;; the old `.toml` names are still recognized for backward
    ;; compatibility with existing projects, but every new project (see
    ;; new.h#) and every place bytes.hk itself *writes* a config file now
    ;; canonically uses `Bytes.hk`.
    let candidates: [string] = ["Bytes.hk", "bytes.hk", "Bytes.toml", "bytes.toml"]
    for c in candidates is
        if file_exists(c) is return c end
    end
    return ""
end

pub fn find_hk_upward() -> string is
    ;; Search current dir and up to 5 parents
    let direct: string = find_hk()
    if direct != "" is return direct end
    let mut dir: string = ".."
    let mut depth: int = 0
    while depth < 5 is
        for name in ["Bytes.hk", "bytes.hk"] is
            let p: string = dir + "/" + name
            if file_exists(p) is return p end
        end
        dir   = dir + "/.."
        depth += 1
    end
    return ""
end

pub fn load() -> Project is
    let path: string = find_hk()
    if path == "" is
        write("  \x1b[31merror:\x1b[0m Bytes.hk not found")
        write("  Run 'bytes new <name>' to create a project")
        exit(1)
    end
    let mut proj: Project = parse(file_read(path))
    proj.root_path = "."
    return proj
end

pub fn load_path(path: string) -> Project is
    let mut proj: Project = parse(file_read(path))
    let slash: int = string_rfind(path, "/")
    proj.root_path = if slash >= 0 then string_slice(path, 0, slash) else "." 
    return proj
end

;; ── Accessors ────────────────────────────────────────────────────────────────

pub fn pkg_name(proj: Project) -> string is return proj.package.name end
pub fn pkg_version(proj: Project) -> string is return proj.package.version end

pub fn build_entry(proj: Project) -> string is
    if proj.build.entry != "" is return proj.build.entry end
    if proj.package.entry != "" is return proj.package.entry end
    return "src/main.h#"
end

pub fn build_output(proj: Project) -> string is
    if proj.build.output != "" is return proj.build.output end
    return "build/" + proj.package.name
end

pub fn build_lang(proj: Project) -> string is
    if proj.build.lang != "" is return proj.build.lang end
    return "h#"
end

;; [FIXED] `workspace.h#` used to read `ws.name`, `ws.version` and
;; `ws.build_order` directly off a `let ws: WorkspaceConfig = proj.workspace`
;; local — a cross-module nested-field chain. The h# v0.8 compiler warns
;; "cannot statically determine the struct type of `.name`/`.version`/
;; `.build_order` — guessing by scanning all structs for a matching field
;; name" for exactly this pattern, because `PackageConfig`, `WorkspaceConfig`
;; and `BuildConfig` all have fields with the same names (`name`, `version`,
;; `build_order`). At runtime the guess picks the wrong struct's field
;; layout, so `ws.version` was silently reading back `ws.mode`'s value
;; instead (reproduced live: `bytes build` printed "hco-workspace
;; vstandard" instead of "hco-workspace v0.4.0" — "standard" is the
;; *mode*, not the version). Every other nested-field read in this file
;; (`build_entry`, `build_output`, `ws_members`, `pkg_name`, ...) already
;; goes through a same-module accessor function instead of a raw chain,
;; and those never triggered the warning — so the fix is to give
;; `WorkspaceConfig`'s fields the same treatment instead of reading them
;; directly from other modules.
pub fn ws_name(proj: Project) -> string is
    return proj.workspace.name
end

pub fn ws_version(proj: Project) -> string is
    return proj.workspace.version
end

pub fn ws_mode(proj: Project) -> string is
    return proj.workspace.mode
end

pub fn ws_build_order(proj: Project) -> string is
    return proj.workspace.build_order
end

;; [FIXED] `jit.h#`'s `jit_cache_new` used to read `proj.build.cache_dir`
;; directly — the same cross-module ambiguous-chain issue as
;; `ws_name`/`ws_version` above (`.build` and `.cache_dir` both flagged
;; by the compiler: "cannot statically determine the struct type of
;; `.build`/`.cache_dir` — guessing by scanning all structs"). Added
;; here for the same reason: a same-module accessor resolves correctly.
pub fn build_cache_dir(proj: Project) -> string is
    if proj.build.cache_dir != "" is return proj.build.cache_dir end
    return "build/cache"
end

pub fn ws_members(proj: Project) -> [string] is
    let raw: string = string_replace(string_replace(
        string_replace(proj.workspace.members, "[", ""), "]", ""), "\"", "")
    let parts: [string] = string_split(raw, ",")
    let n: int = array_len(parts)
    let mut result: [string] = []
    let mut i: int = 0
    while i < n is
        let m: string = string_trim(parts[i])
        if m != "" is result = array_push(result, m) end
        i += 1
    end
    return result
end

pub fn ws_member_lang(proj: Project, member: string) -> string is
    let pairs: [string] = string_split(proj.workspace.languages, ",")
    let n: int = array_len(pairs)
    let mut i: int = 0
    while i < n is
        let pair: string = string_trim(pairs[i])
        let eq: int = string_find(pair, "=")
        if eq > 0 is
            let m: string = string_trim(string_slice(pair, 0, eq))
            let l: string = string_trim(string_slice(pair, eq + 1, string_len(pair)))
            if m == member is return l end
        end
        i += 1
    end
    return "h#"
end

;; ── Templates ────────────────────────────────────────────────────────────────

pub fn tpl_package(name: string) -> string is
    return "[package]\n-> name        => " + name + "\n" +
           "-> version     => 0.1.0\n-> description => " + name + "\n" +
           "-> author      =>\n-> license     => MIT\n\n" +
           "[build]\n-> lang   => h#\n-> entry  => src/main.h#\n" +
           "-> output => build/" + name + "\n\n[deps]\n"
end

pub fn tpl_workspace(name: string) -> string is
    return "! " + name + " workspace\n\n[workspace]\n" +
           "-> name    => " + name + "\n-> version => 0.1.0\n" +
           "-> mode    => standard\n-> members => [\"" + name + "-core\"]\n\n" +
           "[build]\n-> parallel => true\n-> cache    => build/cache/\n"
end

pub fn tpl_lib_hk(name: string) -> string is
    return "[package]\n-> name    => " + name + "\n-> version => 0.1.0\n\n" +
           "[build]\n-> lang   => h#\n-> entry  => src/lib.h#\n" +
           "-> output => build/lib" + name + "\n-> emit   => lib\n"
end

pub fn tpl_main(name: string) -> string is
    return ";; " + name + " — main entry point\n\nfn main() is\n" +
           "    write(\"Hello from " + name + "!\")\nend\n"
end

pub fn tpl_lib_source(name: string) -> string is
    return ";; " + name + " — library\n\npub fn hello() -> string is\n" +
           "    return \"Hello from " + name + "!\"\nend\n"
end

pub fn tpl_gitignore() -> string is
    return "build/\nbuild/cache/\n*.jit\n*.h#bc\n"
end

pub fn tpl_hk_gitignore() -> string is
    return "build/\nbuild/cache/\n*.jit\n*.h#bc\n"
end
