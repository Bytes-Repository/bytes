;; ── add / remove (runtime) ────────────────────────────────────────────────────

pub fn cmd_add(name: string, kind: string, source: string, verbose: bool) -> int is
    ;; 1. Add to bytes.hk
    let hk_path: string = config::find_hk()
    if hk_path == "" is
        write("  \x1b[31merror:\x1b[0m bytes.hk not found")
        return 1
    end

    let content: string = file_read(hk_path)
    ;; Insert into whichever spelling of the section this project's
    ;; Bytes.hk already uses — "[deps]" (canonical) or "[dependencies]"
    ;; (the Cargo-style alias config::parse also accepts — see its
    ;; section-header comment). Falling back to always creating a brand
    ;; new "[deps]" block regardless would leave a project that already
    ;; has "[dependencies]" with two separate dependency sections.
    let existing_header: string = if string_contains(content, "[deps]") then "[deps]"
                                   else if string_contains(content, "[dependencies]") then "[dependencies]"
                                   else "" 
    let dep_line: string = "-> " + name + " => " + if source != "" then source else kind 

    let new_content: string = if existing_header != "" is
        string_replace(content, existing_header, existing_header + "\n" + dep_line)
    else is
        content + "\n[deps]\n" + dep_line + "\n"
    end

    file_write(hk_path, new_content)
    write("  \x1b[32m✓\x1b[0m  added: " + name +
          if kind != "" then " [" + kind + "]" else "" )

    ;; 2. If git dep, install immediately
    if kind == "git" || string_starts_with(source, "http") is
        let target: string = pkg_cache_dir() + "/" + name
        if !dir_exists(pkg_cache_dir()) is dir_create(pkg_cache_dir()) end
        let add_result: InstallOutcome = install_git_dep(name, source, target, verbose)
        if add_result.note != "" is write(add_result.note) end
    end

    write("  Run 'bytes build' to compile")
    return 0
end

pub fn cmd_remove_dep(name: string) -> int is
    let hk_path: string = config::find_hk()
    if hk_path == "" is
        write("  \x1b[31merror:\x1b[0m bytes.hk not found")
        return 1
    end

    let content: string = file_read(hk_path)
    let lines:   [string] = string_split(content, "\n")
    let n:       int = array_len(lines)
    let mut new_content: string = ""
    let mut removed: bool = false
    let mut i: int = 0

    while i < n is
        let key: string = config::hk_parse_key(lines[i])
        if key == name && string_starts_with(string_trim(lines[i]), "->") is
            removed = true
        else is
            new_content = new_content + lines[i] + "\n"
        end
        i += 1
    end

    if !removed is
        write("  \x1b[33mwarn:\x1b[0m '" + name + "' not found in [deps]")
        return 1
    end

    file_write(hk_path, new_content)

    ;; Also remove from lockfile
    let mut lf: lockfile::LockFile = lockfile::lockfile_read()
    lf = lockfile::lockfile_unlock(lf, name)
    lockfile::lockfile_write(lf)

    write("  \x1b[32m✓\x1b[0m  removed: " + name)
    return 0
end
