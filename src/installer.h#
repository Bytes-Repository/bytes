fn pkg_cache_dir() -> string is return "build/cache/packages" end
fn py_cache_dir()  -> string is return "build/cache/pyenv"    end

pub fn install_all(proj: config::Project, release: bool, verbose: bool) -> bool is
    let ok_hsh: bool = install_hsharp_deps(proj, verbose)
    let ok_py:  bool = install_python_deps(proj, verbose)
    return ok_hsh && ok_py
end

;; ── H# zależności ─────────────────────────────────────────────────────────────

fn install_hsharp_deps(proj: config::Project, verbose: bool) -> bool is
    if proj.dep_count == 0 is return true end

    if !dir_exists(pkg_cache_dir()) is dir_create(pkg_cache_dir()) end

    write("  \x1b[2mFetching " + to_string(proj.dep_count) + " dependency(ies)...\x1b[0m")

    let mut lf:     lockfile::LockFile = lockfile::lockfile_read()
    let mut bar:    progress::ProgressBar = progress::bar_new(proj.dep_count, "default", "deps")
    let mut failed: int  = 0
    let mut i:      int  = 0

    while i < proj.dep_count is
        let dep: config::DepEntry = proj.deps[i]

        ;; Check cache first
        let cached_path: string = pkg_cache_dir() + "/" + dep.name
        let locked: lockfile::LockedPkg = lockfile::lockfile_get(lf, dep.name)

        if locked.name != "" && dir_exists(cached_path) is
            if verbose is write("  \x1b[2m" + dep.name + " (cached)\x1b[0m") end
            bar = progress::bar_inc(bar, 1)
            i += 1
            continue
        end

        ;; Fetch from registry or git
        let ok: bool = match dep.kind is
            "git" => is install_git_dep(dep.name, dep.source, cached_path, verbose) end
            "bytes" => is install_bytes_dep(dep.name, cached_path, verbose) end
            "dynamic" | "static" => is
                ;; System library — verify with pkg-config, no download needed
                if verbose is write("  \x1b[2m" + dep.name + " (system lib)\x1b[0m") end
                true
            end
            _ => is
                if verbose is write("  \x1b[2m" + dep.name + " (unknown kind " + dep.kind + ")\x1b[0m") end
                true
            end
        end

        if ok is
            lf = lockfile::lockfile_lock(lf, dep.name, dep.source, dep.source, "")
        else is
            write("  \x1b[33mwarn:\x1b[0m  failed to fetch " + dep.name)
            failed += 1
        end

        bar = progress::bar_inc(bar, 1)
        i += 1
    end

    lockfile::lockfile_write(lf)
    progress::bar_finish(bar, to_string(proj.dep_count - failed) + " package(s) ready")

    return failed == 0
end

fn install_git_dep(name: string, url: string, target: string, verbose: bool) -> bool is
    if dir_exists(target) is
        if verbose is write("  \x1b[2m" + name + " (git cached)\x1b[0m") end
        return true
    end
    let cmd: string = "git clone --depth=1 '" + url + "' '" + target + "' 2>/dev/null"
    if verbose is write("  \x1b[2m$ " + cmd + "\x1b[0m") end
    return system(cmd) == 0
end

fn install_bytes_dep(name: string, target: string, verbose: bool) -> bool is
    ;; Fetch registry and look up package
    let reg: registry::Registry = registry::registry_load_cached()
    let entry: registry::RegEntry = registry::registry_find(reg, name)

    if entry.name == "" is
        ;; Create stub .h# file so compilation can proceed
        let stub: string = pkg_cache_dir() + "/" + name + ".h#"
        file_write(stub, ";; bytes stub: " + name + "\n;; Install via: bytes add " + name + "\n")
        write("  \x1b[33mwarn:\x1b[0m '" + name + "' not in registry, stub created")
        return true
    end

    return install_git_dep(name, entry.git, target, verbose)
end

