extern dynamic [c] is
    fn system(cmd: string) -> int
end

pub struct PyEnv is
    pub version:  string
    pub venv_dir: string
end

fn find_python(version: string) -> string is
    let candidates: [string] = [
        "python" + version,
        "python" + string_slice(version, 0, 1),
        "python3",
        "python",
    ]
    for py in candidates is
        if system("command -v " + py + " >/dev/null 2>&1") == 0 is
            return py
        end
    end
    ;; Fallback absolutes
    for p in ["/usr/bin/python3", "/usr/local/bin/python3"] is
        if file_exists(p) is return p end
    end
    return "python3"
end

pub fn pyenv_setup(version: string, cache_dir: string) -> PyEnv is
    let venv_dir: string = cache_dir + "/venv"
    if !dir_exists(venv_dir) is
        let python: string = find_python(version)
        let rc: int = system(python + " -m venv " + venv_dir + " 2>/dev/null")
        if rc != 0 is
            write("  \x1b[33mwarn:\x1b[0m failed to create venv at " + venv_dir)
        end
    end
    return PyEnv { version: version, venv_dir: venv_dir }
end

pub fn pyenv_install(env: PyEnv, pkg: string, ver: string) -> bool is
    let pip:  string = env.venv_dir + "/bin/pip"
    let spec: string = if ver != "" && ver != "latest" then pkg + "==" + ver else pkg 

    let pip_to_use: string = if file_exists(pip) then pip else "pip3" 
    let rc: int = system(pip_to_use + " install -q '" + spec + "' 2>/dev/null")
    if rc != 0 is
        ;; Try user-level fallback
        let rc2: int = system("pip3 install -q --user '" + spec + "' 2>/dev/null")
        return rc2 == 0
    end
    return true
end

pub fn setup_python_deps(pkgs: [string], pkg_count: int, version: string, cache_dir: string) -> bool is
    if pkg_count == 0 is return true end

    if !dir_exists(cache_dir) is dir_create(cache_dir) end
    let env: PyEnv = pyenv_setup(version, cache_dir)

    write("  \x1b[2mInstalling " + to_string(pkg_count) + " Python package(s)...\x1b[0m")

    let mut failed: int = 0
    let mut i: int = 0
    while i < pkg_count is
        let pkg: string = pkgs[i]
        if !pyenv_install(env, pkg, "") is
            write("  \x1b[33mwarn:\x1b[0m failed to install Python package: " + pkg)
            failed += 1
        else is
            write("  \x1b[32m✓\x1b[0m  " + pkg)
        end
        i += 1
    end

    return failed == 0
end

pub fn resolve_python_import(pkg: string, venv_dir: string) -> string is
    ;; Check venv site-packages
    let tmp: string = "/tmp/bytes_py_find_" + to_string(proc_id()) + ".txt"
    system("find " + venv_dir + "/lib -name '" + pkg + "' -maxdepth 4 2>/dev/null | head -1 > " + tmp)
    let result: string = string_trim(file_read(tmp))
    file_delete(tmp)
    return result
end
