extern dynamic [c] is
    fn system(cmd: string) -> int
end

pub struct RegEntry is
    pub name:    string
    pub git:     string
    pub version: string
end

pub struct Registry is
    pub packages: [RegEntry]
    pub count:    int
end

;; [FIXED] Callers outside this module (installer.h#'s `install_bytes_dep`,
;; cli.h#'s `cmd_info_pkg`) used to read `entry.name`/`entry.git` directly
;; off a `let entry: registry::RegEntry = registry_find(...)` local — the
;; same cross-module ambiguous-field issue documented in config.h#'s
;; `ws_name` fix (flagged here for `.name` and `.git`, since `DepEntry`
;; and `LockedPkg` also have a `.name`). Same fix: a same-module accessor.
pub fn reg_name(e: RegEntry) -> string is return e.name end
pub fn reg_git(e: RegEntry)  -> string is return e.git  end
pub fn reg_version(e: RegEntry) -> string is return e.version end

fn index_url() -> string is
    return "https://raw.githubusercontent.com/Bytes-Repository/repository/main/index.json"
end

fn cache_index_path() -> string is
    return "build/cache/registry-index.json"
end

pub fn registry_fetch() -> Registry is
    let tmp: string = "/tmp/bytes_registry_" + to_string(proc_id()) + ".json"
    let rc:  int    = system("curl -fsSL --max-time 10 '" + index_url() + "' -o " + tmp + " 2>/dev/null")
    if rc != 0 is
        write("  \x1b[33mwarn:\x1b[0m nie można pobrać rejestru pakietów (brak sieci?)")
        return Registry { packages: [], count: 0 }
    end

    if !file_exists(tmp) is
        return Registry { packages: [], count: 0 }
    end

    let json: string = file_read(tmp)
    file_delete(tmp)

    ;; Cache locally
    if dir_exists("build/cache") is
        file_write(cache_index_path(), json)
    end

    return registry_parse(json)
end

pub fn registry_load_cached() -> Registry is
    if file_exists(cache_index_path()) is
        return registry_parse(file_read(cache_index_path()))
    end
    return registry_fetch()
end

pub fn registry_parse(json: string) -> Registry is
    ;; Parse: [{"name":"url"}, ...]
    let mut pkgs:  [RegEntry] = []
    let mut count: int        = 0

    ;; [FIXED] This parser splits on the literal substring "},{" to
    ;; separate array entries — which only ever matches when the JSON
    ;; is fully compact, with each object butted right up against the
    ;; next (`{"a":"b"},{"c":"d"}`). The real, live registry-index.json
    ;; (both the version `registry_fetch` downloads and the one
    ;; `build/cache/registry-index.json` caches locally) is
    ;; pretty-printed — each `}`/`{` sits on its own line, separated by
    ;; a comma, a newline, and indentation:
    ;;
    ;;   {
    ;;     "hprompt": "https://github.com/Bytes-Repository/hprompt"
    ;;   },
    ;;   {
    ;;     ...
    ;;
    ;; so the literal "},{" NEVER occurs anywhere in the actual file,
    ;; `string_split` finds nothing to split on, `items` ends up as a
    ;; single one-element array holding the *entire* JSON blob, and the
    ;; body below — which strips every `{`/`}` from that "one item" and
    ;; then takes quote_parts[1]/[3] as *the* name/url — only ever
    ;; recovers the very first entry in the whole file ("mold" in the
    ;; registry seen in practice), silently dropping every other
    ;; package, "hprompt" included — hence `bytes` reporting a package
    ;; "not in registry" that's plainly sitting right there in the
    ;; index. Stripping whitespace up front turns the pretty-printed
    ;; form back into the compact form this parser already handles,
    ;; with no other change needed: none of the fields here (bare
    ;; package names, plain https:// git URLs) can legitimately contain
    ;; a space/tab/newline of their own, so this is safe to do
    ;; unconditionally rather than only for still-more-special-cased
    ;; formatting variants.
    let json: string = string_replace(json, " ", "")
    let json: string = string_replace(json, "\t", "")
    let json: string = string_replace(json, "\n", "")
    let json: string = string_replace(json, "\r", "")

    ;; Split by "},{" to get individual objects
    let items: [string] = string_split(json, "},{")
    let n: int = array_len(items)
    let mut i: int = 0

    while i < n is
        let item: string = string_replace(string_replace(items[i], "{", ""), "}", "")
        ;; item looks like: "name":"url"
        let quote_parts: [string] = string_split(item, "\"")
        ;; indices: 0="" 1=name 2=":" 3=url 4=""
        if array_len(quote_parts) >= 4 is
            let name: string = string_trim(quote_parts[1])
            let url:  string = string_trim(quote_parts[3])
            if name != "" && url != "" is
                pkgs  = array_push(pkgs, RegEntry { name: name, git: url, version: "latest" })
                count += 1
            end
        end
        i += 1
    end

    return Registry { packages: pkgs, count: count }
end

pub fn registry_find(reg: Registry, name: string) -> RegEntry is
    let mut i: int = 0
    while i < reg.count is
        if reg.packages[i].name == name is
            return reg.packages[i]
        end
        i += 1
    end
    return RegEntry { name: "", git: "", version: "" }
end

pub fn registry_search(reg: Registry, query: string) -> [RegEntry] is
    let mut results: [RegEntry] = []
    let q: string = string_lower(query)
    let mut i: int = 0
    while i < reg.count is
        let p: RegEntry = reg.packages[i]
        if string_contains(string_lower(p.name), q) is
            results = array_push(results, p)
        end
        i += 1
    end
    return results
end

pub fn registry_print(reg: Registry) is
    write("  \x1b[1mBytes Registry\x1b[0m (" + to_string(reg.count) + " pakietów)")
    write("")
    let mut i: int = 0
    while i < reg.count is
        let p: RegEntry = reg.packages[i]
        write("  \x1b[36m" + string_pad_right(p.name, 24) + "\x1b[0m  " + p.git)
        i += 1
    end
    write("")
end
