extern dynamic [c] is
    fn system(cmd: string) -> int
end

pub struct RegEntry is
    pub name:    string
    pub git:     string
    pub version: string
end

pub struct Registry is
    pub packages: [RegEntry]
    pub count:    int
end

fn index_url() -> string is
    return "https://raw.githubusercontent.com/Bytes-Repository/repository/main/index.json"
end

fn cache_index_path() -> string is
    return "build/cache/registry-index.json"
end

pub fn registry_fetch() -> Registry is
    let tmp: string = "/tmp/bytes_registry_" + to_string(proc_id()) + ".json"
    let rc:  int    = system("curl -fsSL --max-time 10 '" + index_url() + "' -o " + tmp + " 2>/dev/null")
    if rc != 0 is
        write("  \x1b[33mwarn:\x1b[0m nie można pobrać rejestru pakietów (brak sieci?)")
        return Registry { packages: [], count: 0 }
    end

    if !file_exists(tmp) is
        return Registry { packages: [], count: 0 }
    end

    let json: string = file_read(tmp)
    file_delete(tmp)

    ;; Cache locally
    if dir_exists("build/cache") is
        file_write(cache_index_path(), json)
    end

    return registry_parse(json)
end

pub fn registry_load_cached() -> Registry is
    if file_exists(cache_index_path()) is
        return registry_parse(file_read(cache_index_path()))
    end
    return registry_fetch()
end

pub fn registry_parse(json: string) -> Registry is
    ;; Parse: [{"name":"url"}, ...]
    let mut pkgs:  [RegEntry] = []
    let mut count: int        = 0

    ;; Split by "},{" to get individual objects
    let items: [string] = string_split(json, "},{")
    let n: int = array_len(items)
    let mut i: int = 0

    while i < n is
        let item: string = string_replace(string_replace(items[i], "{", ""), "}", "")
        ;; item looks like: "name":"url"
        let quote_parts: [string] = string_split(item, "\"")
        ;; indices: 0="" 1=name 2=":" 3=url 4=""
        if array_len(quote_parts) >= 4 is
            let name: string = string_trim(quote_parts[1])
            let url:  string = string_trim(quote_parts[3])
            if name != "" && url != "" is
                pkgs  = array_push(pkgs, RegEntry { name: name, git: url, version: "latest" })
                count += 1
            end
        end
        i += 1
    end

    return Registry { packages: pkgs, count: count }
end

pub fn registry_find(reg: Registry, name: string) -> RegEntry is
    let mut i: int = 0
    while i < reg.count is
        if reg.packages[i].name == name is
            return reg.packages[i]
        end
        i += 1
    end
    return RegEntry { name: "", git: "", version: "" }
end

pub fn registry_search(reg: Registry, query: string) -> [RegEntry] is
    let mut results: [RegEntry] = []
    let q: string = string_lower(query)
    let mut i: int = 0
    while i < reg.count is
        let p: RegEntry = reg.packages[i]
        if string_contains(string_lower(p.name), q) is
            results = array_push(results, p)
        end
        i += 1
    end
    return results
end

pub fn registry_print(reg: Registry) is
    write("  \x1b[1mBytes Registry\x1b[0m (" + to_string(reg.count) + " pakietów)")
    write("")
    let mut i: int = 0
    while i < reg.count is
        let p: RegEntry = reg.packages[i]
        write("  \x1b[36m" + string_pad_right(p.name, 24) + "\x1b[0m  " + p.git)
        i += 1
    end
    write("")
end
