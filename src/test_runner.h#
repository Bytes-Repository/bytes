extern dynamic [c] is
    fn system(cmd: string) -> int
end

pub struct TestResult is
    pub name:    string
    pub passed:  bool
    pub output:  string
    pub elapsed: int
end

pub struct TestSummary is
    pub total:  int
    pub passed: int
    pub failed: int
    pub files:  int
end

fn collect_test_files(extra: [string], extra_count: int) -> [string] is
    if extra_count > 0 is
        let mut result: [string] = []
        let mut i: int = 0
        while i < extra_count is
            if !string_starts_with(extra[i], "--") is
                result = array_push(result, extra[i])
            end
            i += 1
        end
        return result
    end
    let tmp: string = "/tmp/bytes_test_files_" + to_string(proc_id()) + ".txt"
    system("find . -name '*.h#' ! -path './build/*' | grep -E '(test|spec)' | sort > " + tmp + " 2>/dev/null")
    ;; Also check src/ for #[test] blocks
    system("grep -rl '#\\[test\\]' src/ 2>/dev/null | sort >> " + tmp + " 2>/dev/null")
    let content: string = file_read(tmp)
    file_delete(tmp)
    if content == "" is return [] end
    let lines:  [string] = string_split(content, "\n")
    let n:      int = array_len(lines)
    let mut result: [string] = []
    ;; Deduplicate
    let mut i: int = 0
    while i < n is
        let l: string = string_trim(lines[i])
        if l == "" is i += 1 continue end
        let mut dup: bool = false
        let mut j: int = 0
        while j < array_len(result) is
            if result[j] == l is dup = true end
            j += 1
        end
        if !dup is result = array_push(result, l) end
        i += 1
    end
    return result
end

fn extract_test_names(content: string) -> [string] is
    ;; Find all #[test]\n fn test_xxx() is ... blocks
    let mut tests:  [string] = []
    let lines:      [string] = string_split(content, "\n")
    let n:          int      = array_len(lines)
    let mut i: int = 0
    while i < n - 1 is
        let line: string = string_trim(lines[i])
        if line == "#[test]" is
            let next: string = string_trim(lines[i + 1])
            if string_starts_with(next, "fn ") is
                let fn_rest: string = string_slice(next, 3, string_len(next))
                let paren:   int    = string_find(fn_rest, "(")
                let test_name: string = if paren >= 0 then
                    string_slice(fn_rest, 0, paren)
                else fn_rest
                tests = array_push(tests, string_trim(test_name))
            end
        end
        i += 1
    end
    return tests
end

fn run_single_test(file: string, test_name: string, verbose: bool) -> TestResult is
    let t0: int  = time_ms()
    let tmp: string = "/tmp/bytes_test_out_" + to_string(proc_id()) + ".txt"

    ;; Run: h# check file --test test_name
    let hsh: string = if system("command -v h# >/dev/null 2>&1") == 0 then "h#" else "hsharp" 
    let cmd: string = hsh + " check " + file + " --test " + test_name + " 2>&1"
    let rc:  int    = system(cmd + " > " + tmp)
    let out: string = file_read(tmp)
    file_delete(tmp)

    return TestResult {
        name:    test_name,
        passed:  rc == 0,
        output:  out,
        elapsed: time_ms() - t0,
    }
end

pub fn cmd_test(extra: [string], extra_count: int, filter: string, verbose: bool) -> int is
    write("")
    write("  \x1b[1;36mbytes test\x1b[0m  H# Test Runner")
    write("")

    let files: [string] = collect_test_files(extra, extra_count)
    let n:     int      = array_len(files)

    if n == 0 is
        write("  \x1b[2mNo .h# test files found.\x1b[0m")
        write("  \x1b[2mPlace #[test] fn blocks in src/ or name files *test*.h#\x1b[0m")
        return 0
    end

    let mut total_passed: int = 0
    let mut total_failed: int = 0
    let mut total_files:  int = 0
    let mut i: int = 0

    while i < n is
        let file: string = files[i]
        if !file_exists(file) is i += 1 continue end

        let content: string    = file_read(file)
        let tests:   [string]  = extract_test_names(content)
        let tn:      int       = array_len(tests)

        if tn == 0 is i += 1 continue end

        write("  \x1b[2m" + file + "\x1b[0m")
        total_files += 1

        let mut j: int = 0
        while j < tn is
            let test_name: string = tests[j]

            ;; Apply filter
            if filter != "" && !string_contains(test_name, filter) is
                j += 1
                continue
            end

            let res: TestResult = run_single_test(file, test_name, verbose)

            if res.passed is
                write("  \x1b[32m✓\x1b[0m  " + test_name +
                      "  \x1b[2m(" + to_string(res.elapsed) + "ms)\x1b[0m")
                total_passed += 1
            else is
                write("  \x1b[31m✗\x1b[0m  " + test_name +
                      "  \x1b[2m(" + to_string(res.elapsed) + "ms)\x1b[0m")
                if res.output != "" && (verbose || total_failed < 3) is
                    let out_lines: [string] = string_split(res.output, "\n")
                    let on:        int      = array_len(out_lines)
                    let mut k: int = 0
                    while k < on && k < 8 is
                        let l: string = string_trim(out_lines[k])
                        if l != "" is write("       \x1b[31m" + l + "\x1b[0m") end
                        k += 1
                    end
                end
                total_failed += 1
            end
            j += 1
        end
        write("")
        i += 1
    end

    write("  \x1b[2m" + string_repeat("─", 48) + "\x1b[0m")

    if total_failed == 0 is
        write("  \x1b[32m✓\x1b[0m  " + to_string(total_passed) + " test(s) passed in " +
              to_string(total_files) + " file(s)")
        return 0
    else is
        write("  \x1b[31m✗\x1b[0m  " + to_string(total_passed) + "/" +
              to_string(total_passed + total_failed) + " passed, " +
              to_string(total_failed) + " failed")
        return 1
    end
end
