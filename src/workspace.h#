mod config
mod progress

extern dynamic [c] is
    fn system(cmd: string) -> int
end

fn capture(cmd: string) -> string is
    let tmp: string = "/tmp/bytes_ws_" + to_string(proc_id()) + ".txt"
    system(cmd + " >" + tmp + " 2>&1")
    let out: string = file_read(tmp)
    file_delete(tmp)
    return out
end

;; Basename of a path — "isolated/build/isolated" -> "isolated". Used
;; only for naming the copy collected into the workspace-root `build/`
;; directory (see build_workspace); doc_gen.h# has its own file_stem
;; (which also strips an extension) but it isn't `pub`, and stripping an
;; extension isn't wanted here since these binaries have none.
fn path_basename(path: string) -> string is
    let slash: int = string_rfind(path, "/")
    if slash >= 0 is return string_slice(path, slash + 1, string_len(path)) end
    return path
end

;; Single-quote a path for safe use in a shell command (same approach as
;; util.h#'s shell_quote, copied locally since workspace.h# doesn't `mod
;; util` for anything else). Needed for the `cp` below: `file_read`/
;; `file_write` are C-string based and would corrupt a binary at its
;; first \0 byte, so an actual `cp` is the only safe way to duplicate an
;; executable.
fn sh_quote(s: string) -> string is
    return "'" + string_replace_all(s, "'", "'\\''") + "'"
end

;; BUG FIX: every language branch below used to run the exact same build
;; command TWICE — once via `capture(cmd)` to get its output, and again
;; via a separate `system(cmd + " >/dev/null 2>&1")` just to get the exit
;; status, throwing that second run's output away. Besides doubling every
;; member's build time, it's also just wrong for anything with side
;; effects or non-deterministic timing. `capture_with_status` runs the
;; command exactly once and returns both the combined output and the real
;; exit code from that one run, via a shell `; echo` trick that appends
;; the status after the command's own output into the same capture file.
;; parse_exit_code converts a plain non-negative digit string (a shell
;; `$?` exit code, always 0-255) to `int`, without going through the
;; `parse_int` builtin — which returns `int?` (Optional), and H#'s
;; typechecker does not reliably narrow that back to plain `int` after an
;; `== nil` guard (see Isolator-H-Sharp's README for the same issue hit
;; repeatedly during that port). A small manual digit-by-digit scan
;; sidesteps the Optional entirely. Malformed input (shouldn't happen —
;; this always parses `$?`) just yields 0.
fn parse_exit_code(s: string) -> int is
    let t: string = string_trim(s)
    let n: int = string_len(t)
    let mut result: int = 0
    let mut i: int = 0
    while i < n is
        let c: string = string_at(t, i)
        if c >= "0" && c <= "9" is
            let d: int = string_find("0123456789", c)
            result = result * 10 + d
        end
        i += 1
    end
    return result
end

fn capture_with_status(cmd: string) -> (string, int) is
    let tmp: string = "/tmp/bytes_ws_" + to_string(proc_id()) + "_" + to_string(time_ms()) + ".txt"
    system("{ " + cmd + "; echo \"__BYTES_EXIT__:$?\"; } >" + tmp + " 2>&1")
    let raw: string = file_read(tmp)
    file_delete(tmp)
    let marker: string = "__BYTES_EXIT__:"
    let idx: int = string_rfind(raw, marker)
    if idx < 0 is
        ;; marker missing (shouldn't happen) — treat as failure so a
        ;; broken capture is never silently reported as success
        return (raw, 1)
    end
    let out: string = string_slice(raw, 0, idx)
    let code_str: string = string_trim(string_slice(raw, idx + string_len(marker), string_len(raw)))
    let code: int = parse_exit_code(code_str)
    return (out, code)
end

fn find_hsh() -> string is
    let bins: [string] = ["h#", "hsharp", "./h#"]
    for b in bins is
        if system("command -v " + b + " >/dev/null 2>&1") == 0 is return b end
    end
    return "h#"
end

;; ── Toolchain preflight ───────────────────────────────────────────────────────

struct ToolchainCheck is
    pub lang:    string
    pub binary:  string
    pub hint:    string
    pub present: bool
end

fn check_toolchain(lang: string) -> ToolchainCheck is
    let binary: string = match lang is
        "h#" | "hsharp"    => find_hsh()
        "rust"             => "cargo"
        "c++" | "cpp"      => "c++"
        "c"                => "cc"
        "odin"             => "odin"
        "zig"              => "zig"
        "crystal"          => "crystal"
        "go" | "golang"    => "go"
        "python" | "py"    => "python3"
        _                  => lang
    end
    let hint: string = match lang is
        "h#" | "hsharp"    => "part of HackerOS toolchain"
        "rust"             => "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh"
        "c++" | "cpp"      => "sudo apt install g++"
        "c"                => "sudo apt install gcc"
        "odin"             => "https://odin-lang.org/docs/install"
        "zig"              => "sudo snap install zig --beta --classic"
        "crystal"          => "sudo apt install crystal"
        "go" | "golang"    => "sudo apt install golang"
        "python" | "py"    => "sudo apt install python3"
        _                  => "check PATH"
    end
    let present: bool = system("command -v " + binary + " >/dev/null 2>&1") == 0
    return ToolchainCheck { lang: lang, binary: binary, hint: hint, present: present }
end

;; ── Member build ─────────────────────────────────────────────────────────────

pub fn build_member(name: string, lang: string, release: bool, verbose: bool) -> progress::MemberStatus is
    let t0: int = time_ms()

    ;; [FIXED] `verbose` was accepted by this function but never actually
    ;; read anywhere in its body — `bytes build --release --verbose`
    ;; produced byte-for-byte identical output to `bytes build --release`.
    if verbose is
        write("  \x1b[2m» building member '" + name + "' (" + lang + ")\x1b[0m")
    end

    ;; Canonicalize member dir — try CWD first, then BYTES_WORKSPACE_ROOT
    ;; NOTE: `name + ""` (not a bare `let x: string = name`) on purpose —
    ;; a plain identifier RHS registers as a *move* of `name` under
    ;; @default/@safety's move-after-use check, and `name` is still read
    ;; many times below (error messages, the returned MemberStatus, …).
    let mut member_dir: string = name + ""
    if !dir_exists(name) is
        let ws_root: string = env_get("BYTES_WORKSPACE_ROOT")
        if ws_root != "" is
            let abs: string = ws_root + "/" + name
            if dir_exists(abs) is member_dir = abs end
        end
    end

    if !dir_exists(member_dir) is
        return MemberStatus {
            name: name, lang: lang, success: false,
            output: "directory '" + name + "' not found",
            elapsed: time_ms() - t0, bin_path: ""
        }
    end

    ;; Ensure build dir
    if !dir_exists(member_dir + "/build") is
        dir_create(member_dir + "/build")
    end

    let rel_flag: string = if release then " --release" else "" 
    let mut success: bool   = false
    let mut output:  string = ""
    ;; EXPANSION: resolved output binary path for this member, when the
    ;; branch below has one — see MemberStatus.bin_path's doc comment.
    let mut bin_path: string = ""
    ;; EXPANSION: label shown by the live spinner (progress::
    ;; run_with_spinner) while this member's build command runs — see
    ;; that function's doc comment for why a spinner instead of just
    ;; blocking in silence like this used to.
    let spin_label: string = name + " \x1b[2m(" + lang + ")\x1b[0m"

    match lang is
        "h#" | "hsharp" => is
            ;; Read member Bytes.hk for entry/output/emit
            let member_hk: string = member_dir + "/Bytes.hk"
            ;; BUG FIX: `config::build_entry(mp)` / `config::build_output(mp)`
            ;; return the raw path as written in the member's OWN Bytes.hk
            ;; (e.g. "src/main.h#"), which is relative to `member_dir` —
            ;; NOT to the workspace root, which is where this process's
            ;; CWD actually is when `system()`/`capture()` runs the
            ;; compile command below. Previously this branch used that
            ;; value as-is (unlike the `else` fallback a few lines down,
            ;; which correctly prefixes `member_dir + "/src/main.h#"`),
            ;; so any member with its own Bytes.hk failed with
            ;; "cannot read `src/main.h#`: No such file or directory" —
            ;; every path was being resolved against the workspace root
            ;; instead of the member's own directory. Also fixes the
            ;; matching bug where the compiled binary's name/location
            ;; silently ignored the member's own `-> output =>` and was
            ;; always hardcoded to `build/main`.
            let entry: string = if file_exists(member_hk) is
                let mp: config::Project = config::load_path(member_hk)
                member_dir + "/" + config::build_entry(mp)
            else is member_dir + "/src/main.h#" end

            let out: string = if file_exists(member_hk) is
                let mp: config::Project = config::load_path(member_hk)
                member_dir + "/" + config::build_output(mp)
            else is member_dir + "/build/main" end
            let hsh: string = find_hsh()

            ;; Check for --emit in member Bytes.hk
            let emit_arg: string = if file_exists(member_hk) is
                let mp: config::Project = config::load_path(member_hk)
                let e: string = mp.build.emit
                if e != "" && e != "bin" then " --emit " + e else "" end
            else ""
            end

            ;; Extra `-I <dir>` for members that reuse another project's
            ;; `.h#` modules via `-> include =>` in their own Bytes.hk
            ;; (see BuildConfig.include's doc comment in config.h#) —
            ;; this is what lets e.g. `isolated` resolve `mod config`
            ;; straight into `../source-code/src/config.h#` without a
            ;; physical copy of that file ever existing under `isolated/`.
            let include_arg: string = if file_exists(member_hk) is
                let mp: config::Project = config::load_path(member_hk)
                let inc: string = mp.build.include
                if inc != "" then " -I " + member_dir + "/" + inc else "" 
            else ""
            end

            let cmd: string = hsh + " compile " + entry + " -o " + out + rel_flag + emit_arg + include_arg
            ;; [FIXED] see `verbose` doc comment above — now actually
            ;; shows the exact command being run when requested.
            if verbose is write("  \x1b[2m$ " + cmd + "\x1b[0m") end
            let __cs: (string, int) = progress::run_with_spinner(cmd, spin_label)
            output   = __cs.0
            success  = __cs.1 == 0
            bin_path = out
        end
        "rust" => is
            let cargo_f: string = if release then " --release" else "" 
            let manifest: string = member_dir + "/Cargo.toml"
            let cmd: string = "cargo build" + cargo_f + " --manifest-path " + manifest
            let __cs: (string, int) = progress::run_with_spinner(cmd, spin_label)
            output  = __cs.0
            success = __cs.1 == 0
        end
        "c++" | "cpp" => is
            let out: string = member_dir + "/build/lib" + name + ".so"
            let opt: string = if release then " -O3 -flto" else " -O0 -g" 
            let cmd: string = "c++ -shared -fPIC -std=c++17 " + member_dir + "/src/*.cpp -o " + out + opt
            let __cs: (string, int) = progress::run_with_spinner(cmd, spin_label)
            output   = __cs.0
            success  = __cs.1 == 0
            bin_path = out
        end
        "c" => is
            let out: string = member_dir + "/build/lib" + name + ".so"
            let opt: string = if release then " -O2" else " -O0 -g" 
            let cmd: string = "cc -shared -fPIC " + member_dir + "/src/*.c -o " + out + opt
            let __cs: (string, int) = progress::run_with_spinner(cmd, spin_label)
            output   = __cs.0
            success  = __cs.1 == 0
            bin_path = out
        end
        "odin" => is
            let out: string = member_dir + "/build/main"
            let opt: string = if release then " -o:aggressive" else "" 
            let cmd: string = "odin build " + member_dir + "/src -out:" + out + opt
            let __cs: (string, int) = progress::run_with_spinner(cmd, spin_label)
            output   = __cs.0
            success  = __cs.1 == 0
            bin_path = out
        end
        "zig" => is
            let cmd: string = "zig build" + if release then " -Doptimize=ReleaseFast" else "" 
            let __cs: (string, int) = progress::run_with_spinner("cd " + member_dir + " && " + cmd, spin_label)
            output  = __cs.0
            success = __cs.1 == 0
        end
        "crystal" => is
            let out: string = member_dir + "/build/main"
            let opt: string = if release then " --release" else "" 
            let cmd: string = "crystal build " + member_dir + "/src/main.cr -o " + out + opt
            let __cs: (string, int) = progress::run_with_spinner(cmd, spin_label)
            output   = __cs.0
            success  = __cs.1 == 0
            bin_path = out
        end
        "go" | "golang" => is
            let out: string = member_dir + "/build/main"
            let cmd: string = "go build -o " + out + " " + member_dir + "/..."
            let __cs: (string, int) = progress::run_with_spinner(cmd, spin_label)
            output   = __cs.0
            success  = __cs.1 == 0
            bin_path = out
        end
        "python" | "py" => is
            ;; Python: just syntax-check
            let cmd: string = "python3 -m py_compile " + member_dir + "/src/main.py"
            let __cs: (string, int) = progress::run_with_spinner(cmd, spin_label)
            output  = __cs.0
            success = __cs.1 == 0
        end
        _ => is
            output  = "unknown language: " + lang
            success = false
        end
    end

    return MemberStatus {
        name: name, lang: lang, success: success,
        output: output, elapsed: time_ms() - t0, bin_path: bin_path
    }
end

;; ── Workspace build ───────────────────────────────────────────────────────────

pub fn build_workspace(proj: config::Project, release: bool, verbose: bool) -> int is
    ;; Set CWD to workspace root
    let ws_root: string = env_get("BYTES_WORKSPACE_ROOT")
    if ws_root != "" is
        system("cd " + ws_root)
    end

    let members: [string] = config::ws_members(proj)
    let n: int = array_len(members)

    ;; [FIXED] see config.h#'s ws_build_order doc comment — no more
    ;; direct `ws.build_order` chain (was silently reading garbage).
    let raw_build_order: string = config::ws_build_order(proj)

    ;; Determine build order
    let order: [string] = if raw_build_order != "" is
        let raw: string = string_replace(string_replace(
            string_replace(raw_build_order, "[", ""), "]", ""), "\"", "")
        let parts: [string] = string_split(raw, ",")
        let pn: int = array_len(parts)
        let mut result: [string] = []
        let mut pi: int = 0
        while pi < pn is
            let m: string = string_trim(parts[pi])
            if m != "" is result = array_push(result, m) end
            pi += 1
        end
        result
    else is
        members
    end

    let order_n: int = array_len(order)

    ;; Preflight toolchain checks
    let mut missing_langs: [string] = []
    let mut checked: [string] = []
    let mut i: int = 0
    while i < order_n is
        let m:    string = string_trim(order[i])
        let lang: string = config::ws_member_lang(proj, m)
        ;; Only check each lang once
        let mut already: bool = false
        let mut ci: int = 0
        while ci < array_len(checked) is
            if checked[ci] == lang is already = true end
            ci += 1
        end
        if !already is
            let tc: ToolchainCheck = check_toolchain(lang)
            if !tc.present is
                write("  \x1b[33mwarn:\x1b[0m " + lang + " toolchain not found — " + tc.hint)
                missing_langs = array_push(missing_langs, lang)
            end
            checked = array_push(checked, lang)
        end
        i += 1
    end

    ;; [FIXED] see config.h#'s ws_name/ws_version doc comment — was
    ;; `ws.name`/`ws.version` (raw chain off a WorkspaceConfig local),
    ;; which the compiler resolves ambiguously and which was observed to
    ;; print the workspace's *mode* in place of its *version*.
    progress::print_build_header(config::ws_name(proj), config::ws_version(proj), release)
    write("  \x1b[2m── Workspace build (" + to_string(order_n) + " member(s)) ───────────────────\x1b[0m")
    write("")

    let t_start:    int = time_ms()
    let mut passed: int = 0
    let mut failed: int = 0
    let mut results: [progress::MemberStatus] = []
    ;; EXPANSION: overall "N/M members done" bar, pinned to the bottom of
    ;; the terminal for the whole workspace build — see bar_clear's doc
    ;; comment in progress.h# for exactly how "pinned" is achieved here
    ;; (BUG FIX from the previous version of this loop: it called
    ;; `write("")` right after every `bar_inc`, which sealed each frame
    ;; as its own permanent line instead of letting the next `\r` redraw
    ;; overwrite it — that's what produced a new static bar block after
    ;; every single member instead of one bar updating in place).
    let mut wsbar: progress::ProgressBar = progress::bar_new(order_n, "default", "workspace")
    progress::bar_redraw(wsbar)
    i = 0

    while i < order_n is
        let member: string = string_trim(order[i])
        if member == "" is i += 1 continue end

        let lang: string = config::ws_member_lang(proj, member)

        ;; Skip if toolchain missing
        let mut skip: bool = false
        let mut mi: int = 0
        while mi < array_len(missing_langs) is
            if missing_langs[mi] == lang is skip = true end
            mi += 1
        end

        if skip is
            progress::bar_clear()
            write("  \x1b[33m-\x1b[0m " + string_pad_right(member, 20) + " \x1b[2mskipped (no toolchain)\x1b[0m")
            wsbar = progress::bar_inc(wsbar, 1)
            i += 1
            continue
        end

        ;; Relinquish the pinned bottom line to build_member's own
        ;; per-file spinner while it compiles (same row, same idea —
        ;; only one "live" indicator owns that line at a time), then
        ;; take it back once the member's result line has scrolled up.
        progress::bar_clear()
        let res: progress::MemberStatus = build_member(member, lang, release, verbose)
        progress::print_member(res)
        wsbar = progress::bar_inc(wsbar, 1)

        if res.success is passed += 1 else failed += 1 end
        results = array_push(results, res)

        ;; EXPANSION: also collect this member's binary into one shared
        ;; top-level `build/` directory at the workspace root — the
        ;; Cargo-`target/{debug,release}/`-style single place every
        ;; workspace binary ends up, instead of only under its own
        ;; `<member>/build/...`  (which still exists too — this is a
        ;; copy, not a move, so nothing that already depended on the
        ;; per-member path breaks).
        if res.success && res.bin_path != "" && file_exists(res.bin_path) is
            let ws_build_dir: string = if ws_root != "" then ws_root + "/build" else "build" 
            if !dir_exists(ws_build_dir) is dir_create(ws_build_dir) end
            let collected: string = ws_build_dir + "/" + path_basename(res.bin_path)
            system("cp -f " + sh_quote(res.bin_path) + " " + sh_quote(collected))
        end
        i += 1
    end
    ;; Final seal: erase the pinned bar one last time before the summary
    ;; prints (write() doesn't clear a line on its own — without this the
    ;; summary would be appended straight onto the end of the bar's
    ;; unterminated last row instead of starting on a clean one).
    progress::bar_clear()

    let elapsed: int = time_ms() - t_start
    progress::print_build_summary(passed, failed, elapsed)

    return if failed == 0 then 0 else 1 
end
