mod config
mod progress

extern dynamic [c] is
    fn system(cmd: string) -> int
    fn getenv(name: string) -> string
end

fn capture(cmd: string) -> string is
    let tmp: string = "/tmp/bytes_ws_" + to_string(proc_id()) + ".txt"
    system(cmd + " >" + tmp + " 2>&1")
    let out: string = file_read(tmp)
    file_delete(tmp)
    return out
end

fn find_hsh() -> string is
    let bins: [string] = ["h#", "hsharp", "./h#"]
    for b in bins is
        if system("command -v " + b + " >/dev/null 2>&1") == 0 is return b end
    end
    return "h#"
end

;; ── Toolchain preflight ───────────────────────────────────────────────────────

struct ToolchainCheck is
    pub lang:    string
    pub binary:  string
    pub hint:    string
    pub present: bool
end

fn check_toolchain(lang: string) -> ToolchainCheck is
    let binary: string = match lang is
        "h#" | "hsharp"    => find_hsh()
        "rust"             => "cargo"
        "c++" | "cpp"      => "c++"
        "c"                => "cc"
        "odin"             => "odin"
        "zig"              => "zig"
        "crystal"          => "crystal"
        "go" | "golang"    => "go"
        "python" | "py"    => "python3"
        _                  => lang
    end
    let hint: string = match lang is
        "h#" | "hsharp"    => "part of HackerOS toolchain"
        "rust"             => "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh"
        "c++" | "cpp"      => "sudo apt install g++"
        "c"                => "sudo apt install gcc"
        "odin"             => "https://odin-lang.org/docs/install"
        "zig"              => "sudo snap install zig --beta --classic"
        "crystal"          => "sudo apt install crystal"
        "go" | "golang"    => "sudo apt install golang"
        "python" | "py"    => "sudo apt install python3"
        _                  => "check PATH"
    end
    let present: bool = system("command -v " + binary + " >/dev/null 2>&1") == 0
    return ToolchainCheck { lang: lang, binary: binary, hint: hint, present: present }
end

;; ── Member build ─────────────────────────────────────────────────────────────

pub fn build_member(name: string, lang: string, release: bool, verbose: bool) -> progress::MemberStatus is
    let t0: int = time_ms()

    ;; Canonicalize member dir — try CWD first, then BYTES_WORKSPACE_ROOT
    let mut member_dir: string = name
    if !dir_exists(name) is
        let ws_root: string = getenv("BYTES_WORKSPACE_ROOT")
        if ws_root != "" is
            let abs: string = ws_root + "/" + name
            if dir_exists(abs) is member_dir = abs end
        end
    end

    if !dir_exists(member_dir) is
        return progress::MemberStatus {
            name: name, lang: lang, success: false,
            output: "directory '" + name + "' not found",
            elapsed: time_ms() - t0
        }
    end

    ;; Ensure build dir
    if !dir_exists(member_dir + "/build") is
        dir_create(member_dir + "/build")
    end

    let rel_flag: string = if release then " --release" else "" 
    let mut success: bool   = false
    let mut output:  string = ""

    match lang is
        "h#" | "hsharp" => is
            ;; Read member bytes.hk for entry/emit
            let member_hk: string = member_dir + "/bytes.hk"
            let entry: string = if file_exists(member_hk) is
                let mp: config::Project = config::load_path(member_hk)
                config::build_entry(mp)
            else is member_dir + "/src/main.h#" end

            let out: string = member_dir + "/build/main"
            let hsh: string = find_hsh()

            ;; Check for --emit in member bytes.hk
            let emit_arg: string = if file_exists(member_hk) is
                let mp: config::Project = config::load_path(member_hk)
                let e: string = mp.build.emit
                if e != "" && e != "bin" then " --emit " + e else "" 
            else ""

            let cmd: string = hsh + " compile " + entry + " -o " + out + rel_flag + emit_arg
            output  = capture(cmd)
            success = system(cmd + " >/dev/null 2>&1") == 0
        end
        "rust" => is
            let cargo_f: string = if release then " --release" else "" 
            let manifest: string = member_dir + "/Cargo.toml"
            let cmd: string = "cargo build" + cargo_f + " --manifest-path " + manifest
            output  = capture(cmd)
            success = system(cmd + " >/dev/null 2>&1") == 0
        end
        "c++" | "cpp" => is
            let out: string = member_dir + "/build/lib" + name + ".so"
            let opt: string = if release then " -O3 -flto" else " -O0 -g" 
            let cmd: string = "c++ -shared -fPIC -std=c++17 " + member_dir + "/src/*.cpp -o " + out + opt
            output  = capture(cmd)
            success = system(cmd + " >/dev/null 2>&1") == 0
        end
        "c" => is
            let out: string = member_dir + "/build/lib" + name + ".so"
            let opt: string = if release then " -O2" else " -O0 -g" 
            let cmd: string = "cc -shared -fPIC " + member_dir + "/src/*.c -o " + out + opt
            output  = capture(cmd)
            success = system(cmd + " >/dev/null 2>&1") == 0
        end
        "odin" => is
            let out: string = member_dir + "/build/main"
            let opt: string = if release then " -o:aggressive" else "" 
            let cmd: string = "odin build " + member_dir + "/src -out:" + out + opt
            output  = capture(cmd)
            success = system(cmd + " >/dev/null 2>&1") == 0
        end
        "zig" => is
            let cmd: string = "zig build" + if release then " -Doptimize=ReleaseFast" else "" 
            output  = capture("cd " + member_dir + " && " + cmd)
            success = system("cd " + member_dir + " && " + cmd + " >/dev/null 2>&1") == 0
        end
        "crystal" => is
            let out: string = member_dir + "/build/main"
            let opt: string = if release then " --release" else "" 
            let cmd: string = "crystal build " + member_dir + "/src/main.cr -o " + out + opt
            output  = capture(cmd)
            success = system(cmd + " >/dev/null 2>&1") == 0
        end
        "go" | "golang" => is
            let out: string = member_dir + "/build/main"
            let cmd: string = "go build -o " + out + " " + member_dir + "/..."
            output  = capture(cmd)
            success = system(cmd + " >/dev/null 2>&1") == 0
        end
        "python" | "py" => is
            ;; Python: just syntax-check
            let cmd: string = "python3 -m py_compile " + member_dir + "/src/main.py"
            output  = capture(cmd)
            success = system(cmd + " >/dev/null 2>&1") == 0
        end
        _ => is
            output  = "unknown language: " + lang
            success = false
        end
    end

    return progress::MemberStatus {
        name: name, lang: lang, success: success,
        output: output, elapsed: time_ms() - t0
    }
end

;; ── Workspace build ───────────────────────────────────────────────────────────

pub fn build_workspace(proj: config::Project, release: bool, verbose: bool) -> int is
    ;; Set CWD to workspace root
    let ws_root: string = getenv("BYTES_WORKSPACE_ROOT")
    if ws_root != "" is
        system("cd " + ws_root)
    end

    let ws: config::WorkspaceConfig = proj.workspace
    let members: [string] = config::ws_members(proj)
    let n: int = array_len(members)

    ;; Determine build order
    let order: [string] = if ws.build_order != "" is
        let raw: string = string_replace(string_replace(
            string_replace(ws.build_order, "[", ""), "]", ""), "\"", "")
        let parts: [string] = string_split(raw, ",")
        let pn: int = array_len(parts)
        let mut result: [string] = []
        let mut pi: int = 0
        while pi < pn is
            let m: string = string_trim(parts[pi])
            if m != "" is result = array_push(result, m) end
            pi += 1
        end
        result
    else is
        members
    end

    let order_n: int = array_len(order)

    ;; Preflight toolchain checks
    let mut missing_langs: [string] = []
    let mut checked: [string] = []
    let mut i: int = 0
    while i < order_n is
        let m:    string = string_trim(order[i])
        let lang: string = config::ws_member_lang(proj, m)
        ;; Only check each lang once
        let mut already: bool = false
        let mut ci: int = 0
        while ci < array_len(checked) is
            if checked[ci] == lang is already = true end
            ci += 1
        end
        if !already is
            let tc: ToolchainCheck = check_toolchain(lang)
            if !tc.present is
                write("  \x1b[33mwarn:\x1b[0m " + lang + " toolchain not found — " + tc.hint)
                missing_langs = array_push(missing_langs, lang)
            end
            checked = array_push(checked, lang)
        end
        i += 1
    end

    progress::print_build_header(ws.name, ws.version, release)
    write("  \x1b[2m── Workspace build (" + to_string(order_n) + " member(s)) ───────────────────\x1b[0m")
    write("")

    let t_start:    int = time_ms()
    let mut passed: int = 0
    let mut failed: int = 0
    let mut results: [progress::MemberStatus] = []
    i = 0

    while i < order_n is
        let member: string = string_trim(order[i])
        if member == "" is i += 1 continue end

        let lang: string = config::ws_member_lang(proj, member)

        ;; Skip if toolchain missing
        let mut skip: bool = false
        let mut mi: int = 0
        while mi < array_len(missing_langs) is
            if missing_langs[mi] == lang is skip = true end
            mi += 1
        end

        if skip is
            write("  \x1b[33m-\x1b[0m " + string_pad_right(member, 20) + " \x1b[2mskipped (no toolchain)\x1b[0m")
            i += 1
            continue
        end

        let res: progress::MemberStatus = build_member(member, lang, release, verbose)
        progress::print_member(res)

        if res.success is passed += 1 else failed += 1 end
        results = array_push(results, res)
        i += 1
    end

    let elapsed: int = time_ms() - t_start
    progress::print_build_summary(passed, failed, elapsed)

    return if failed == 0 then 0 else 1 
end
